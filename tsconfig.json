{
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "compilerOptions": {
    "lib": [
      "DOM",
      "ES2022"
    ],
    "types": [],
    "typeRoots": [
      "./node_modules/@types",
      "../../node_modules/@types"
    ],
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "strict": true
  }
}
